# ==============================================================================
# FX Exposure Management Platform - Environment Variables Template
# Copy this file to .env and configure with your local or cloud environment values.
# NEVER commit your actual .env file or real credentials to source control.
# ==============================================================================

# Database Configuration (PostgreSQL / Neon Cloud)
DB_URL=jdbc:postgresql://<your-db-host>:<port>/<database-name>?sslmode=require
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

# JWT Authentication Configuration
# Provide a 256-bit (32+ character) base64 or plaintext secret for signing tokens
JWT_SECRET=<your-jwt-secret-key-at-least-256-bits>
JWT_EXPIRATION=3600000

# Server Configuration (Optional, defaults to 8080)
PORT=8080
